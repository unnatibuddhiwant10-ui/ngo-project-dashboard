pipeline {
    agent any

    environment {
        REGISTRY = 'docker.io'
        DOCKER_USER = 'ngodevops'
        IMAGE_NAME = 'ngo-project-dashboard'
        VERSION_TAG = "1.0.${BUILD_NUMBER}"
        CONTAINER_PORT = '8080'
    }

    stages {
        stage('1. Checkout') {
            steps {
                checkout scm
            }
        }

        stage('2. Test & Quality Gate') {
            steps {
                echo ">>> Running automated tests..."
                sh 'mvn test'
            }
        }

        stage('3. Build Docker Image') {
            steps {
                echo ">>> Building versioned Docker image: ${IMAGE_NAME}:${VERSION_TAG}..."
                sh "docker build -t ${IMAGE_NAME}:${VERSION_TAG} -t ${IMAGE_NAME}:latest -f docker/Dockerfile ."
            }
        }

        stage('4. Push to Container Registry') {
            steps {
                echo ">>> Pushing versioned image ${IMAGE_NAME}:${VERSION_TAG} to registry..."
                /*
                withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                    sh "echo $PASS | docker login -u $USER --password-stdin ${REGISTRY}"
                    sh "docker push ${IMAGE_NAME}:${VERSION_TAG}"
                    sh "docker push ${IMAGE_NAME}:latest"
                }
                */
                echo "Simulated push: Image ${IMAGE_NAME}:${VERSION_TAG} published successfully."
            }
        }

        stage('5. Deploy Fresh Container') {
            steps {
                echo ">>> Stopping previous container and deploying ${IMAGE_NAME}:${VERSION_TAG}..."
                sh """
                    docker stop ${IMAGE_NAME} || true
                    docker rm ${IMAGE_NAME} || true
                    docker run -d --name ${IMAGE_NAME} -p ${CONTAINER_PORT}:8080 --restart unless-stopped ${IMAGE_NAME}:${VERSION_TAG}
                """
            }
        }

        stage('6. Post-Deploy Health Check') {
            steps {
                echo ">>> Verifying health of new container..."
                sh """
                    sleep 5
                    curl -s -f http://localhost:${CONTAINER_PORT}/health | grep '"status":"UP"' || exit 1
                    echo "Container is UP and operational!"
                """
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
