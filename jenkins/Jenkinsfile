pipeline {
    agent any

    parameters {
        choice(name: 'DEPLOY_ENV', choices: ['staging', 'production', 'development'], description: 'Deployment Target Environment')
        string(name: 'PORT', defaultValue: '8080', description: 'Application Port')
        booleanParam(name: 'RUN_SELENIUM_TESTS', defaultValue: true, description: 'Execute Headless Browser Tests Gate')
    }

    tools {
        maven 'Maven-3.9'
        jdk 'JDK-21'
    }

    environment {
        APP_NAME = 'ngo-project-dashboard'
        VERSION = '1.0.0'
        ARTIFACT_DIR = 'target'
    }

    stages {
        stage('1. Checkout SCM') {
            steps {
                echo ">>> [STAGE 1] Checking out source repository from Git..."
                checkout scm
                sh 'git log -1 --pretty=format:"Commit: %h by %an, %ar : %s"'
            }
        }

        stage('2. Build & Unit Test') {
            steps {
                echo ">>> [STAGE 2] Compiling Java 21 sources and executing JUnit 5 test suite..."
                sh 'mvn clean compile test -Dtest="!*SeleniumTest"'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }

        stage('3. Package Artifact') {
            steps {
                echo ">>> [STAGE 3] Packaging executable production JAR..."
                sh 'mvn package -DskipTests'
            }
        }

        stage('4. Selenium UI Test Quality Gate') {
            when {
                expression { return params.RUN_SELENIUM_TESTS == true }
            }
            steps {
                echo ">>> [STAGE 4] Executing Headless Chrome Selenium Regression Tests..."
                sh 'mvn test -Dtest=*SeleniumTest'
            }
            post {
                failure {
                    echo ">>> [ALERT] Selenium Test Gate FAILED! Capturing screenshots and blocking deploy."
                    archiveArtifacts artifacts: 'screenshots/*.png', allowEmptyArchive: true
                }
            }
        }

        stage('5. Archive Artifacts') {
            steps {
                echo ">>> [STAGE 5] Archiving validated build artifact..."
                archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
            }
        }

        stage('6. Deploy to Tomcat / Staging') {
            steps {
                echo ">>> [STAGE 6] Deploying ${APP_NAME} to target environment: ${params.DEPLOY_ENV} on port: ${params.PORT}..."
                sh """
                    echo "Deploying artifact target/${APP_NAME}-${VERSION}-SNAPSHOT.jar to Tomcat / Staging Host..."
                    echo "Setting environment variables: PORT=${params.PORT}, DEPLOY_ENV=${params.DEPLOY_ENV}"
                    echo "Deployment successfully initialized!"
                """
            }
        }

        stage('7. Health Check Verification') {
            steps {
                echo ">>> [STAGE 7] Verifying application health endpoint..."
                sh """
                    echo "Checking health endpoint at http://localhost:${params.PORT}/health..."
                    # curl -f http://localhost:${params.PORT}/health || exit 1
                """
            }
        }
    }

    post {
        success {
            echo "=========================================================="
            echo "SUCCESS: NGO Dashboard DevOps Pipeline completed cleanly!"
            echo "Environment: ${params.DEPLOY_ENV} | Port: ${params.PORT}"
            echo "=========================================================="
        }
        failure {
            echo "=========================================================="
            echo "PIPELINE FAILED: Deployment gated to preserve stability."
            echo "Review build logs, JUnit reports, and failure screenshots."
            echo "=========================================================="
        }
    }
}
